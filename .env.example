# --- Deployment & Testing (Hardhat / Viem) ---
DEPLOYER_PK=                     # 0x-prefixed 32-byte private key for deployment/testing
ALCHEMY_API_KEY=                 # Recommended: Alchemy API Key from dashboard.alchemy.com
TARGET_RECIPIENT=                # Optional: where Tx 2 sends funds (defaults to sender account for safe test)
WATCH_ADDRESS=                   # Optional: account whose nonce is watched (e.g. Jesse Pollak or any counterparty)

# --- RPC Configuration ---
# If ALCHEMY_API_KEY is provided, Alchemy endpoints are automatically used.
BASE_RPC_URL=                    # Optional override (e.g. https://base-mainnet.g.alchemy.com/v2/YOUR_KEY)
BASE_SEPOLIA_RPC_URL=            # Optional override (e.g. https://base-sepolia.g.alchemy.com/v2/YOUR_KEY)
BASE_SEPOLIA_SEQUENCER_RPC=https://sepolia-sequencer.base.org
BASE_SEQUENCER_RPC=https://mainnet-sequencer.base.org

# --- Contract Configuration ---
QUOTE_TOKEN=                     # USDC address on the target chain
SWAP_ROUTER=                     # Uniswap V3 SwapRouter02 address on the target chain (verify on docs.uniswap.org)
STOCK_TOKEN=                     # Tokenized stock / target token address
PRICE_FEED=                      # Chainlink USD feed for the asset (verify on data.chain.link)
POOL_FEE=3000                    # Uniswap pool fee tier (e.g. 3000 = 0.3%)
MAX_STOCK_IN=10                  # Per-order deposit cap during beta
MAX_QUOTE_IN=500                 # Per-order quote token cap
MAX_DEVIATION_BPS=300            # Oracle-bounded fill guard (300 = 3%)
KEEPER_FEE_BPS=10                # Fee rewarded to keeper on successful fill (10 = 0.1%)
MAX_STALENESS_SECONDS=3600       # Max age of oracle price feed before considered stale
OWNER_ADDRESS=                   # Contract owner / multisig address

# --- Keeper & Validity Transactions ---
CHAIN=baseSepolia                # base | baseSepolia
RPC_URL=https://sepolia.base.org
SEQUENCER_RPC_URL=https://sepolia-sequencer.base.org # Required if VALIDITY_TX=1
ORDER_BOOK=                      # Deployed LimitOrderBook contract address
KEEPER_PK=                       # Dedicated wallet holding gas ETH to execute orders
POLL_MS=5000                     # Polling frequency in milliseconds
START_ORDER_ID=1
START_PLAN_ID=1
VALIDITY_TX=0                    # 1 = use base_sendRawTransactionValidity, 0 = standard transactions
